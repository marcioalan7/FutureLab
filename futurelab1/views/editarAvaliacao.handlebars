<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Avaliação</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="editar-body">
    <main class="editar-container">
        <div class="editar-header">
            <span class="editar-icon">📊</span>
            <h1>Editar Avaliação</h1>
            <p>Altere os dados da avaliação abaixo.</p>
        </div>

        <form 
            action="/editarAvaliacao/{{avaliacao.id}}?_method=PUT" 
            method="POST" 
            class="editar-form"
        >

            <div class="campo">
                <label for="nota">Nota</label>

                <input
                    type="number"
                    id="nota"
                    name="nota"
                    min="1"
                    max="5"
                    value="{{avaliacao.nota}}"
                    required
                >

                <small>Informe uma nota de 1 a 5.</small>
            </div>

            <div class="campo">
                <label for="comentario">Comentário</label>

                <textarea
                    id="comentario"
                    name="comentario"
                    rows="5"
                    placeholder="Digite um comentário..."
                >{{avaliacao.comentario}}</textarea>
            </div>

            <div class="editar-acoes">
                <a href="/gestor/avaliacoes" class="btn-cancelar">
                    Cancelar
                </a>

                <button type="submit" class="btn-salvar">
                    Salvar Alterações
                </button>
            </div>

        </form>
    </main>
</body>
</html>