<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuários</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="lista-header">
        <div>
            <h1>Sistema de Avaliação Docente</h1>
            <p>Usuários cadastrados</p>
        </div>
        <a href="/gestor" class="logout-button">
            Voltar
        </a>
    </header>

    <main class="lista-container">
        <div class="lista-topo">
            <div>
                <h2>Usuários</h2>
                <p>Lista de todos os usuários cadastrados no sistema.</p>
            </div>
            <a href="/inserirUsuario" class="btn-novo">
                + Novo usuário
            </a>
        </div>

        {{#if usuarios}}
            <div class="tabela-container">
                <table class="tabela">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>E-mail</th>
                            <th>Idade</th>
                            <th>Telefone</th>
                            <th>Tipo</th>
                            <th>Disciplina</th>
                            <th>Formação</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each usuarios}}
                            <tr>
                                <td>{{id}}</td>
                                <td>
                                    <strong>{{nome}}</strong>
                                </td>
                                <td>{{email}}</td>
                                <td>{{idade}}</td>
                                <td>{{telefone}}</td>
                                <td>
                                    <span class="tipo-usuario {{tipo}}">
                                        {{tipo}}
                                    </span>
                                </td>
                                <td>{{disciplina}}</td>
                                <td>{{formacao}}</td>
                                <td class="acoes">
                                    <a
                                        href="/editarUsuario/{{id}}"
                                        class="btn-editar">
                                        Editar
                                    </a>
                                    <form
                                        action="/deletarUsuario/{{id}}?_method=DELETE"
                                        method="POST">
                                        <button
                                            type="submit"
                                            class="btn-excluir"
                                            onclick="return confirm('Tem certeza que deseja excluir este usuário?')">
                                            Excluir
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        {{else}}
            <div class="lista-vazia">
                <div class="lista-vazia-icon">
                    👤
                </div>
                <h3>Nenhum usuário cadastrado</h3>
                <p>
                    Ainda não existem usuários cadastrados no sistema.
                </p>
                <a href="/inserirUsuario" class="btn-novo">
                    Cadastrar usuário
                </a>
            </div>
        {{/if}}

    </main>
</body>
</html>