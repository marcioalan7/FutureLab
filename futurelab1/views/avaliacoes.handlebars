<h1>Lista de Avaliações</h1>

<a href="/inserirAvaliacao">
    Inserir nova avaliação
</a>
<a href = "/home">Home</a>

<br><br>

{{#each avaliacoes}}

    <h3>Avaliação</h3>

    <p>Nota: {{nota}}</p>

    <p>Comentário: {{comentario}}</p>

    <p>Usuário ID: {{usuarioId}}</p>

    <p>Pergunta ID: {{perguntaId}}</p>

    <a href="/editarAvaliacao/{{id}}">
        Editar
    </a>

    <br><br>

    <form action="/deletarAvaliacao/{{id}}?_method=DELETE" method="POST">

        <button type="submit">
            Excluir
        </button>

    </form>

    <hr>

{{/each}}