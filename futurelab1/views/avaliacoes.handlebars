<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Avaliações</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="lista-header">
        <div>
            <h1>Sistema de Avaliação Docente</h1>
            <p>Visualização das avaliações</p>
        </div>
        {{#if (eq origem "docente")}}
        <a href="/docente" class="logout-button">
            Voltar
        </a>
        {{else}}
        <a href="/gestor" class="logout-button">
            Voltar
        </a>
        {{/if}}
    </header>

    <main class="lista-container">
        <div class="lista-topo">
            <div>
                <h2>Avaliações realizadas</h2>
                <p>
                    Consulte as avaliações realizadas pelos discentes.
                </p>
            </div>
        </div>

        {{#if avaliacoes}}
            <div class="avaliacoes-lista">
                {{#each avaliacoes}}
                    <div class="avaliacao-card">
                        <div class="avaliacao-topo">
                            <div>
                                <span class="avaliacao-label">
                                    Avaliação #{{id}}
                                </span>
                                <h3>
                                    {{docente.nome}}
                                </h3>
                            </div>

                            <div class="nota">
                                <span>
                                    {{nota}}
                                </span>
                                <small>
                                    / 5
                                </small>
                            </div>
                        </div>

                        <div class="avaliacao-dados">
                            <div class="avaliacao-dado">
                                <strong>
                                    Discente
                                </strong>
                                <span>
                                    {{discente.nome}}
                                </span>
                            </div>

                            <div class="avaliacao-dado">
                                <strong>
                                    Docente
                                </strong>
                                <span>
                                    {{docente.nome}}
                                </span>
                            </div>

                            <div class="avaliacao-dado pergunta-avaliacao">
                                <strong>
                                    Pergunta
                                </strong>
                                <span>
                                    {{pergunta.pergunta}}
                                </span>
                            </div>
                        </div>

                        <div class="comentario">
                            <strong>
                                Comentário
                            </strong>
                            {{#if comentario}}
                                <p>
                                    "{{comentario}}"
                                </p>
                            {{else}}
                                <p class="sem-comentario">
                                    Nenhum comentário foi informado.
                                </p>
                            {{/if}}
                        </div>

                        {{#if (eq ../origem "gestor")}}
                            <div class="avaliacao-acoes">
                                <a href="/editarAvaliacao/{{id}}" class="btn-editar">
                                    Editar
                                </a>

                            <form action="/deletarAvaliacao/{{id}}?_method=DELETE" method="POST">
                                <button
                                    type="submit"
                                    class="btn-excluir"
                                    onclick="return confirm('Tem certeza que deseja excluir esta avaliação?')"
                                    >
                                    Excluir
                                </button>
                            </form>
                            </div>
                            {{/if}}
                    </div>
                {{/each}}
            </div>
        {{else}}

            <div class="lista-vazia">
                <div class="lista-vazia-icon">
                    📋
                </div>
                <h3>
                    Nenhuma avaliação encontrada
                </h3>
                <p>
                    Ainda não existem avaliações realizadas pelos discentes.
                </p>
            </div>
        {{/if}}
    </main>
</body>
</html>